# Ignore binaries in src/ that have no extension
/src/*
!/src/*.*
!/src/*/

# Files from build
**/*.o
**/*.s
src/.depend

# Built binary
src/stockfish*
src/-lstdc++.res

# Neural network for the NNUE evaluation
**/*.nnue
networks/*pilot*.ufnn
networks/*pilot*.ufnn.json
training/*.jsonl

# Build/test artifacts
*.exe
tests/syzygy

# ffishjs
tests/js/node_modules
ffish.js
*.wasm

# pyffish
venv
*.so
pyffish.egg-info
__pycache__
*.pyc

# test artifacts
tests/*.exp
src/*.log
src/*.epd
src/*.txt

# IDEs
.vscode
.idea

# Local proprietary reference packages. These are inputs, never project source.
*.apk
*.apks
*.ipa
*.xapk
reverse-engineering/input/
reverse-engineering/output/

# Cache etc.
.DS_Store
tsconfig.tsbuildinfo
tablebases/*.checkpoint
tablebases/*.tmp
# Production tablebase payloads live in versioned S3; the repository keeps
# only the canonical README ledger and generated plot.
tablebases/*.uftb
tablebases/*.uftb.part*
tablebases/*.ufiw
tablebases/*.ufgm
tablebases/*.ufgi
tablebases/*.uficapture
