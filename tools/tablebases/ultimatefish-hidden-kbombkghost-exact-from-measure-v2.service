[Unit]
Description=Ultimate Fish opposed Bomb/Ghost exact solve from authenticated measurement
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/mnt/ultimatefish/hidden-kbombkghost-7af5dec2/resume-v3
ExecStartPre=/usr/bin/mkdir -p /mnt/ultimatefish/hidden-kbombkghost-7af5dec2/resume-v3/tmp
ExecStart=/usr/bin/python3 /mnt/ultimatefish/resume-runners/bomb-ghost-d9bee1d0/run_ultimate_ghost_bomb_aws.py --manifest bundle-manifest.json --transition-resume-manifest transition-resume-manifest.json --full --resume-completed-measurement
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/mnt/ultimatefish/hidden-kbombkghost-7af5dec2/resume-v3/tools/tablebases
Environment=TMPDIR=/mnt/ultimatefish/hidden-kbombkghost-7af5dec2/resume-v3/tmp
Nice=10
IOSchedulingClass=idle
AllowedCPUs=17
CPUQuota=100%
MemoryHigh=22G
MemoryMax=24G
TasksMax=32
LimitNOFILE=1048576
TimeoutStartSec=infinity
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/mnt/ultimatefish/hidden-kbombkghost-7af5dec2/resume-v2
ReadOnlyPaths=/mnt/ultimatefish/resume-runners/bomb-ghost-d9bee1d0
ReadWritePaths=/mnt/ultimatefish/hidden-kbombkghost-7af5dec2/resume-v3
StandardOutput=append:/mnt/ultimatefish/hidden-kbombkghost-7af5dec2/resume-v3/exact-from-measure-v2.log
StandardError=append:/mnt/ultimatefish/hidden-kbombkghost-7af5dec2/resume-v3/exact-from-measure-v2.log

[Install]
WantedBy=multi-user.target
