[Unit]
Description=Ultimate Fish corrected current-rule concrete K+Ghost vs K+Angel tablebase
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/mnt/ultimatefish/ultimatefish-run-kghostkangel-concrete-current-v1.sh
AllowedCPUs=4-31
CPUQuota=2800%
MemoryMax=137438953472
OOMPolicy=stop
TasksMax=128
LimitNOFILE=65536
Restart=no
TimeoutStartSec=infinity
TimeoutStopSec=60
KillSignal=SIGTERM
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadOnlyPaths=/mnt/ultimatefish/concrete-penguin-current-v1
ReadWritePaths=/mnt/ultimatefish/concrete-ghost-angel-opposed-current-v1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
