[Unit]
Description=Preserve opposed Sniper/Ghost root-admission certification v17
After=ultimatefish-info-kghostksniper-admission-v17.service

[Service]
Type=oneshot
ExecStart=/bin/bash -lc 'while state=$(systemctl show ultimatefish-info-kghostksniper-admission-v17.service -p ActiveState --value); [[ $state = active || $state = activating || $state = reloading ]]; do sleep 15; done; exec /opt/ultimatefish-certification-sprint/preserve.sh /mnt/ultimatefish/opposed-sniper-v12 kghostksniper ultimatefish-info-kghostksniper-admission-v17.service ultimatefish-info-20260808-a4e679c6-831688117652 results/information/opposed/ghost-sniper/admission-v17 32 /mnt/ultimatefish/opposed-sniper-v12/work/logs/admission-certify-v17.log kghostksniper-admission-v17'
AllowedCPUs=32-63
CPUQuota=3200%
MemoryMax=68719476736
ReadWritePaths=/mnt/ultimatefish/opposed-sniper-v12
StandardOutput=journal
StandardError=journal
