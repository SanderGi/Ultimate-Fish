[Unit]
Description=Preserve opposed Sniper/Ghost current-oracle certification v15
After=ultimatefish-info-kghostksniper-current-v15.service

[Service]
Type=oneshot
ExecStart=/bin/bash -lc 'while systemctl is-active --quiet ultimatefish-info-kghostksniper-current-v15.service; do sleep 15; done; exec /opt/ultimatefish-certification-sprint/preserve.sh /mnt/ultimatefish/opposed-sniper-v12 kghostksniper ultimatefish-info-kghostksniper-current-v15.service ultimatefish-info-20260808-a4e679c6-831688117652 results/information/opposed/ghost-sniper/current-v15 32 /mnt/ultimatefish/opposed-sniper-v12/work/logs/current-oracle-certify-v15.log kghostksniper-current-v15'
AllowedCPUs=32-63
CPUQuota=3200%
MemoryMax=68719476736
ReadWritePaths=/mnt/ultimatefish/opposed-sniper-v12
StandardOutput=journal
StandardError=journal
