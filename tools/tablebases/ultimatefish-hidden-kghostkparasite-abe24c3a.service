[Unit]
Description=Ultimate Fish Parasite/Ghost opposing measure-first exact run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/mnt/ultimatefish/hidden-kghostkparasite-abe24c3a
ExecStartPre=/usr/bin/mkdir -p /mnt/ultimatefish/hidden-kghostkparasite-abe24c3a/tmp
ExecStart=/usr/bin/python3 tools/tablebases/run_ultimate_ghost_parasite_aws.py --manifest bundle-manifest.json
Environment=PYTHONUNBUFFERED=1
Environment=TMPDIR=/mnt/ultimatefish/hidden-kghostkparasite-abe24c3a/tmp
Nice=10
IOSchedulingClass=idle
AllowedCPUs=16-31
CPUQuota=1600%
MemoryHigh=28G
MemoryMax=32G
TasksMax=infinity
LimitNOFILE=1048576
TimeoutStartSec=infinity
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/ultimatefish/hidden-kghostkparasite-abe24c3a
StandardOutput=append:/mnt/ultimatefish/hidden-kghostkparasite-abe24c3a/service.log
StandardError=append:/mnt/ultimatefish/hidden-kghostkparasite-abe24c3a/service.log

[Install]
WantedBy=multi-user.target
