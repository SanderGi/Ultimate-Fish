[Unit]
Description=Ultimate Fish concrete wave-0 class 001 authenticated resume v1
Requires=mnt-ultimatefish\x2dresume.mount
After=mnt-ultimatefish\x2dresume.mount network-online.target
Wants=network-online.target
ConditionPathExists=/mnt/ultimatefish-resume/concrete-penguin-1083b6f8/wave0-001-resume-v1/source/ultimatefish/tools/resume_ultimate_concrete_frontier_aws.py
ConditionPathExists=/mnt/ultimatefish-resume/concrete-penguin-1083b6f8/wave0-001-resume-v1/source/ultimatefish/tools/ultimate_concrete_wave0_001_resume.json

[Service]
Type=oneshot
WorkingDirectory=/mnt/ultimatefish-resume/concrete-penguin-1083b6f8/wave0-001-resume-v1/source/ultimatefish
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 tools/resume_ultimate_concrete_frontier_aws.py \
  --manifest tools/ultimate_concrete_wave0_001_resume.json \
  --work-directory /mnt/ultimatefish-resume/concrete-penguin-1083b6f8/wave0-001-resume-v1/work \
  --full --aws-execution-ack EC2 --resident-limit 68719476736 \
  --scratch-limit 85899345920 --reverse-edge-bytes-limit 68719476736 \
  --minimum-free-bytes 214748364800 \
  --minimum-host-memory-available-bytes 137438953472 --monitor-interval 5 \
  --s3-prefix s3://ultimatefish-info-20260808-a4e679c6-831688117652/results/concrete/penguin-causal-1083b6f8
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
AllowedCPUs=0-15
CPUQuota=1600%
MemoryHigh=80G
MemoryMax=96G
OOMPolicy=stop
TasksMax=96
LimitNOFILE=65536
Restart=no
TimeoutStartSec=infinity
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadOnlyPaths=/mnt/ultimatefish/concrete-penguin-1083b6f8/wave0-001-full-v3
ReadOnlyPaths=/mnt/ultimatefish-resume/concrete-penguin-1083b6f8/wave0-001-resume-v1/source
ReadWritePaths=/mnt/ultimatefish-resume/concrete-penguin-1083b6f8/wave0-001-resume-v1
StandardOutput=append:/mnt/ultimatefish-resume/concrete-penguin-1083b6f8/wave0-001-resume-v1/service.log
StandardError=append:/mnt/ultimatefish-resume/concrete-penguin-1083b6f8/wave0-001-resume-v1/service.log
