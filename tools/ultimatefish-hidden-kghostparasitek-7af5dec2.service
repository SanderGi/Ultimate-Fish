[Unit]
Description=Ultimate Fish Parasite/Ghost same measure-first exact run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/mnt/ultimatefish/hidden-kghostparasitek-7af5dec2
ExecStartPre=/usr/bin/mkdir -p /mnt/ultimatefish/hidden-kghostparasitek-7af5dec2/tmp
ExecStart=/usr/bin/python3 tools/run_ultimate_ghost_parasite_aws.py --manifest bundle-manifest.json
Environment=PYTHONUNBUFFERED=1
Environment=TMPDIR=/mnt/ultimatefish/hidden-kghostparasitek-7af5dec2/tmp
Nice=10
IOSchedulingClass=idle
AllowedCPUs=3-31
CPUQuota=2900%
MemoryHigh=28G
MemoryMax=32G
TasksMax=infinity
LimitNOFILE=1048576
TimeoutStartSec=infinity
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/ultimatefish/hidden-kghostparasitek-7af5dec2
StandardOutput=append:/mnt/ultimatefish/hidden-kghostparasitek-7af5dec2/service.log
StandardError=append:/mnt/ultimatefish/hidden-kghostparasitek-7af5dec2/service.log

[Install]
WantedBy=multi-user.target
