[Unit]
Description=Ultimate Fish concrete wave-0 class 020 checkpointed solve
After=network-online.target
Wants=network-online.target
ConditionPathExists=/mnt/ultimatefish-overflow/concrete-penguin-1083b6f8/wave0-020-v1/source/ultimatefish/tools/run_ultimate_concrete_checkpointed_aws.py
ConditionPathExists=/mnt/ultimatefish-overflow/concrete-penguin-1083b6f8/wave0-018-full-v3/dependencies/manifest.json

[Service]
Type=oneshot
WorkingDirectory=/mnt/ultimatefish-overflow/concrete-penguin-1083b6f8/wave0-020-v1/source/ultimatefish
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 tools/run_ultimate_concrete_checkpointed_aws.py \
  --work-directory /mnt/ultimatefish-overflow/concrete-penguin-1083b6f8/wave0-020-v1/work \
  --dependencies /mnt/ultimatefish-overflow/concrete-penguin-1083b6f8/wave0-018-full-v3/dependencies \
  --dependency-manifest /mnt/ultimatefish-overflow/concrete-penguin-1083b6f8/wave0-018-full-v3/dependencies/manifest.json \
  --wave 0 --range-begin 20 --range-end 21 --full --aws-execution-ack EC2 \
  --scratch-limit 51539607552 --resident-limit 68719476736 \
  --reverse-edge-bytes-limit 34359738368 --minimum-free-bytes 274877906944 \
  --monitor-interval 5 \
  --s3-prefix s3://ultimatefish-info-20260808-a4e679c6-831688117652/results/concrete/penguin-causal-1083b6f8
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
AllowedCPUs=0-15
CPUQuota=1600%
MemoryHigh=80G
MemoryMax=96G
OOMPolicy=stop
TasksMax=96
LimitNOFILE=65536
Restart=no
TimeoutStartSec=infinity
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadOnlyPaths=/mnt/ultimatefish-overflow/concrete-penguin-1083b6f8/wave0-018-full-v3
ReadOnlyPaths=/mnt/ultimatefish-overflow/concrete-penguin-1083b6f8/wave0-020-v1/source
ReadWritePaths=/mnt/ultimatefish-overflow/concrete-penguin-1083b6f8/wave0-020-v1
StandardOutput=append:/mnt/ultimatefish-overflow/concrete-penguin-1083b6f8/wave0-020-v1/service.log
StandardError=append:/mnt/ultimatefish-overflow/concrete-penguin-1083b6f8/wave0-020-v1/service.log
